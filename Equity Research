def build_features(ticker, forward=10):
    close  = price_data[ticker]["Close"].squeeze().dropna()
    ret    = close.pct_change().dropna()
    vol    = ret.rolling(21).std()
    sma20  = close.rolling(20).mean()
    sma50  = close.rolling(50).mean()

    feat = pd.DataFrame(index=ret.index)
    feat["ret_1d"]      = ret
    feat["ret_5d"]      = ret.rolling(5).mean()
    feat["ret_21d"]     = ret.rolling(21).mean()
    feat["vol_21d"]     = vol
    feat["vol_63d"]     = ret.rolling(63).std()
    feat["vol_ratio"]   = vol / (ret.rolling(63).std() + 1e-9)
    feat["price_sma20"] = close / sma20 - 1
    feat["price_sma50"] = close / sma50 - 1
    feat["mom_3m"]      = close / close.shift(63)  - 1
    feat["mom_6m"]      = close / close.shift(126) - 1
    feat["sentiment"]   = sentiment_results.get(ticker, {}).get("compound", 0)
    feat["garch_vol"]   = garch_results.get(ticker, {}).get("current_vol_pct", np.nan) / 100
    feat["fin_score"]   = financial_health.get(ticker, {}).get("score_100", 50) / 100

    fwd_ret = close.pct_change(forward).shift(-forward)
    feat["label"] = (fwd_ret > 0).astype(int)
    feat.dropna(inplace=True)
    return feat


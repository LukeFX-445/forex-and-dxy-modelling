def get_close(df, ticker):
    """
    yfinance ≥0.2.18 returns MultiIndex columns like ('Close','QCOM').
    This safely extracts the Close series regardless of version.
    """
    if isinstance(df.columns, pd.MultiIndex):
        # New-style: drop the ticker level
        df.columns = df.columns.droplevel(1)
    if "Close" in df.columns:
        return df["Close"].squeeze()
    if "Adj Close" in df.columns:
        return df["Adj Close"].squeeze()
    raise KeyError(f"Cannot find Close column for {ticker}. Columns: {df.columns.tolist()}")


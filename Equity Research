    close  = price_data[ticker]["Close"].squeeze().dropna()
    ret    = close.pct_change().dropna()
    vol_21 = ret.rolling(21).std()

    def vol_adj_mom(close_s, vol_s, window):
        if len(close_s) < window + 21:
            return np.nan
        cum_ret = close_s.iloc[-1] / close_s.iloc[-window] - 1
        avg_vol = vol_s.iloc[-window:].mean()
        return np.nan if (avg_vol == 0 or np.isnan(avg_vol)) else cum_ret / avg_vol

    momentum_results[ticker] = {
        "mom_3m": vol_adj_mom(close, vol_21, TRADING_DAYS_3M),
        "mom_6m": vol_adj_mom(close, vol_21, TRADING_DAYS_6M),
    }


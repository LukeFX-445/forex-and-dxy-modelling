def normalise_metric(values, higher_is_better=True):
    arr = np.array(values, dtype=float)
    mn, mx = arr.min(), arr.max()
    if mx == mn:
        return np.ones_like(arr) * 0.5
    norm = (arr - mn) / (mx - mn)
    return norm if higher_is_better else 1.0 - norm

tickers_fin = [t for t in valid_tickers if t in RAW_FINANCIALS]
fin_df = pd.DataFrame({t: RAW_FINANCIALS[t] for t in tickers_fin}).T

metrics = ["gross_margin", "eps_ttm", "fwd_eps_growth", "roe", "debt_equity"]
hib     = [True,           True,      True,             True,  False]

X_norm = np.column_stack([
    normalise_metric(fin_df[m].values, h)
    for m, h in zip(metrics, hib)
])

# Stochastic Gradient Descent weight optimisation
np.random.seed(42)
w              = np.ones(len(metrics)) / len(metrics)
lr             = 0.01
n_epochs       = 2000
eps_small      = 1e-8
oracle_weights = np.array([0.25, 0.10, 0.30, 0.25, 0.10])
y_target       = X_norm @ oracle_weights
loss_history   = []

for epoch in range(n_epochs):
    idx   = np.random.randint(0, len(tickers_fin))
    x_i   = X_norm[idx]
    y_hat = np.dot(w, x_i)
    grad  = 2 * (y_hat - y_target[idx]) * x_i
    w    -= lr * grad
    w     = np.maximum(w, eps_small)
    w    /= w.sum()
    if epoch % 100 == 0:
        loss_history.append(np.mean((X_norm @ w - y_target) ** 2))

health_scores_raw = X_norm @ w
mn_s, mx_s = health_scores_raw.min(), health_scores_raw.max()
health_scores_100 = (health_scores_raw - mn_s) / (mx_s - mn_s + eps_small) * 100

def score_to_grade(s):
    if s >= 85: return "A+"
    if s >= 75: return "A"
    if s >= 65: return "B+"
    if s >= 55: return "B"
    if s >= 45: return "C+"
    if s >= 35: return "C"
